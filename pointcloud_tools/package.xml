<?xml version="1.0"?>
<package format="2">

  <name>pointcloud_tools</name>
  <version>0.0.4</version>
  <description>pointcloud_tools</description>
  <maintainer email="bo-miquel.nordfeldt@uib.cat">Bo Miquel Nordfeldt-Fiol</maintainer>

  <license>BSD-4-Clause</license>

  <url type="website">http://ros.org/wiki/pointcloud_tools</url>
  <url type="bugtracker">https://github.com/srv/srv_tools/issues</url>
  <url type="repository">https://github.com/srv/srv_tools</url>

  <author email="plnegre@uib.es">Pep Lluis Negre</author>

  <!-- Build tool -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>roscpp</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>libvtk</build_depend>
  <build_depend>pcl_conversions</build_depend>

  <!-- Exec dependencies -->
  <exec_depend>roscpp</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>libvtk</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>

  <export>
  </export>

</package>
