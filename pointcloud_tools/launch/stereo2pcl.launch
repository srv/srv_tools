<launch>
    <arg name="bag_folder" default="/home/uib/bagfiles/El_Sec/11_31_33" />
    <arg name="output_pointcloud" default="$(arg bag_folder)/nube_completa_estereo.ply" />
    <arg name="rate" default="1" />
    <arg name="start_time" default="0.0" />
    
    <arg name="robot_name" default="sparus2"/>
    <arg name="world_frame" default="world_ned"/> 
    
    <arg name="camera_name"        default="flir_spinnaker_stereo_camera"/>
    <arg name="resolution"         default="full"/> 
    <arg name="slave_camera_name"  default="starboard"/>
    <arg name="master_camera_name" default="port"/>
    <arg name="decimate" default="x2" /> 
    
    <arg name="enableRviz" default="false"/>

    <param name="/use_sim_time" value="true"/>

    <node pkg="pointcloud_tools" type="bag_player.py" name="rosbag_player" 
        args="$(arg bag_folder) $(arg rate) $(arg start_time)"  />
        <!-- output="screen" -->
       

    <include file="$(find sparus2_description)/launch/sparus2_description.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>

    <group ns="$(arg robot_name)">
        <include file="$(find pointcloud_tools)/launch/stereo_processing/stereo_pipeline.launch">
            <arg name="stereo" value="$(arg camera_name)"/>
            <arg name="resolution" value="$(arg resolution)"/>
            <arg name="slave_camera_name"  value="$(arg slave_camera_name)"/>
            <arg name="master_camera_name" value="$(arg master_camera_name)"/>
            
            <arg name="enable_decimate_x1" value="$(eval arg('decimate') == 'x1')"/>
            <arg name="enable_decimate_x2" value="$(eval arg('decimate') == 'x2')"/>
            <arg name="enable_decimate_x4" value="$(eval arg('decimate') == 'x4')"/>
            <arg name="enable_decimate_x8" value="$(eval arg('decimate') == 'x8')"/>
        </include>
    </group>

    <node pkg="pointcloud_tools" type="pcl_aggregator.py" name="cloud_aggregator" output="screen">
        <param name="world_frame" value="$(arg world_frame)"/>
        <param name="output_file" value="$(arg output_pointcloud)"/>
        <param name="input_topic" value="/$(arg robot_name)/$(arg camera_name)/scaled_$(arg decimate)/points2"/>
        <param name="voxel_size" value="0.05"/> 
    </node>


    <group if="$(arg enableRviz)">
        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find pointcloud_tools)/pointcloud_viewer.rviz"/>
    </group>

</launch>