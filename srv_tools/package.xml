<?xml version="1.0"?>
<package format="2">

  <name>srv_tools</name>
  <version>0.0.8</version>
  <description>Stack with interesting ROS tools</description>
  <maintainer email="bo-miquel.nordfeldt@uib.cat">Bo Miquel Nordfeldt-Fiol</maintainer>

  <license>BSD-4-Clause</license>

  <url type="website">http://ros.org/wiki/srv_tools</url>
  <url type="bugtracker">https://github.com/srv/srv_tools/issues</url>
  <url type="repository">https://github.com/srv/srv_tools</url>

  <author email="stwirth@uib.es">Stephan Wirth</author>
  <author email="miquel.massot@uib.es">Miquel Massot</author>

  <!-- Build tool -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Exec dependencies -->
  <exec_depend>launch_tools</exec_depend>
  <exec_depend>tf_tools</exec_depend>
  <exec_depend>pointcloud_tools</exec_depend>
  <exec_depend>bag_tools</exec_depend>
  <exec_depend>plot_tools</exec_depend>

  <export>
    <metapackage/>
  </export>

</package>
