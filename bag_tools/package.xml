<?xml version="1.0"?>
<package format="2">

  <name>bag_tools</name>
  <version>0.2.0</version>
  <description>ROS tools and scripts related to bagfiles</description>
  <maintainer email="bo-miquel.nordfeldt@uib.cat">Bo Miquel Nordfeldt-Fiol</maintainer>

  <license>BSD-4-Clause</license>

  <url type="website">http://ros.org/wiki/bag_tools</url>
  <url type="bugtracker">https://github.com/srv/srv_tools/issues</url>
  <url type="repository">https://github.com/srv/srv_tools</url>

  <author email="stwirth@uib.es">Stephan Wirth</author>
  <author email="miquel.massot@uib.es">Miquel Massot</author>

  <!-- Build tool -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- System Dependencies (Build + Exec) -->
  <depend>libconsole-bridge-dev</depend>

  <!-- ROS Dependencies (Build + Exec) -->
  <depend>rospy</depend>
  <depend>roscpp</depend>
  <depend>rosbag</depend>
  <depend>cv_bridge</depend>
  <depend>image_proc</depend>
  <depend>sensor_msgs</depend>
  <depend>image_geometry</depend>
  <depend>message_filters</depend>
  <depend>stereo_image_proc</depend>
  <depend>camera_calibration_parsers</depend>

  <!-- Optional -->
  <depend>image_preprocessing</depend>

  <export>
  </export>

</package>
